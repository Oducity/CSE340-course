<%- include('partials/header') %>
<main>
  <h1 class="heading1"><%= title %></h1>
  
  <section class="project-page-details">
    <h2>Details</h2>
    <ul class="list">

      <li class="tag-box">
        <% if ((categoryTag?.length ?? 0) === 0) { %>
          <span class="noTag">
            <span class="no-tag">No Tag</span>
          </span>
        <% } else { %> 
          <% categoryTag.forEach((tag) => { %>
            <span>
              <a href="/category/<%= tag.categoryId %>">
                <img
                  src="/images/<%=tag.category_tag%>"
                  alt="<%= tag.category_tag %>" width="24" height="24"
                />
              </a>
            </span>
          <% }) %>
        <% } %>
      </li>
      <li>
        <Strong>Organization : </Strong>
        <span> <%= projectDetails.organizationName %> </span>
      </li>
      <li>
        <Strong>Title :</Strong>
        <span> <%= projectDetails.projectTitle %> </span>
      </li>
      <li>
        <Strong>Project Description : </Strong>
        <span> <%= projectDetails.projectDescription %> </span>
      </li>
      <li>
        <Strong>Project Location : </Strong>
        <span> <%= projectDetails.projectLocation %> </span>
      </li>
      <li>
        <Strong>Project Date : </Strong>
        <span> <%= projectDetails.projectDate %> </span>
      </li>
      <% if (locals.user && locals.user.role_name === 'admin' ) { %>
        <li>
          <span class="add-link">
            <a class="edit-link" href="/new-projectFormPage">Add new service project</a>
          </span>
        </li>
        <li>
          <span class="edit">
            <a class="edit-link" href="/assign-categories/<%= projectDetails.project_id %>">Edit Project Categories</a>
          </span>
        </li>
        <li>
          <span class="edit">
            <a class="edit-link" href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
          </span>
        </li>
      <% } %>

    </ul>
    
  </section>
  
</main>
<%- include('partials/footer') %>
