<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <span><a href="/new-projectFormPage">Add new service project</a></span>
  <section>
    <h2>Details</h2>
    <ul class="list">
      <li class="tag-box">
        <% if ((categoryTag?.length ?? 0) === 0) { %>
          <span class="noTag">
            <span class="no-tag">No Tag</span>
          </span>
        <% } else { %> 
          <% categoryTag.forEach((tag) => { %>
            <span>
              <a href="/category/<%= tag.categoryId %>">
                <%- tag.category_tag %>
              </a>
            </span>
          <% }) %>
        <% } %>
      </li>
      <li>
        <Strong>Organization : </Strong>
        <span> <%= projectDetails.organizationName %> </span>
      </li>
      <li>
        <Strong>Title :</Strong>
        <span> <%= projectDetails.projectTitle %> </span>
      </li>
      <li>
        <Strong>Project Description : </Strong>
        <span> <%= projectDetails.projectDescription %> </span>
      </li>
      <li>
        <Strong>Project Location : </Strong>
        <span> <%= projectDetails.projectLocation %> </span>
      </li>
      <li>
        <Strong>Project Date : </Strong>
        <span> <%= projectDetails.projectDate %> </span>
      </li>
    </ul>
  </section>
</main>
<%- include('partials/footer') %>
