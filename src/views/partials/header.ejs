<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <nav class="navbar">
      <ul class="nav-list">
        <li class="nav-items">
          <a href="/">Home</a>
        </li>
        <li class="nav-items">
          <a href="/organizations">Organizations</a>
        </li>
        <li class="nav-items">
          <a href="/projects">Service Projects</a>
        </li>
        <li class="nav-items">
          <a href="/category">Categories</a>
        </li>
        <li>
            <span class="nav-items nav-right">
              <% if (isLoggedIn) { %>
                <a href="/logout">Logout</a>
              <% } else { %>
                <a href="/login">Login</a><div class="nav-divider">|</div>
                <a href="/register">Register</a>
              <% } %>
          </span>
        </li>
      </ul>

    </nav>
    <div class="nav-bottom-belt" ></div>
    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
      <% if(messages[type].length > 0) { %>
        <% messages[type].forEach((msg) => { %>
          <span class="alert <%= type %>">
            <%= msg %>
          </span>
        <% }); %>
      <% }; %>
    <% }); %>
