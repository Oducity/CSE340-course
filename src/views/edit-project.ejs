<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <form action="/edit-project/<%= projectData.project_id %>" method="POST">
        
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                name="title"
                id="title"
                minlength="3"
                maxlength="200"
                required 
                value="<%= projectData.projectTitle %>" 
            />
        </div>

        <div class="form-group">
            <label for="description">Project Description</label>
            <textarea
                name="description"
                id="description"
                minlength="20"
                maxlength="999"
                required>
                    <%= projectData.projectDescription %>
            </textarea>
        </div>

        <div class="form-group">
            <label for="project_location">Project Location</label>
            <textarea 
                name="project_location"
                id="project_location"
                required minlength="3"
                maxlength="300">
                    <%= projectData.projectLocation %>
            </textarea>
        </div>

        <div class="form-group">
            <label for="project_date">Project Date</label>
            <input
                type="date"
                name="project_date"
                id="project_date"
                required
                value="<%= projectData.projectDate %>" 
            />
        </div>
    
        <div class="form-group">
            <label for="organization_id">Organization Name</label>
            <select name="organization_id" id="organization_id" required>
                <% allOrganization.forEach((organization) => { %>
                    <option value="<%= organization.organization_id %>">
                        <%= organization.organization_name %>
                    </option>
                <% }) %>
            </select>
        </div>
        <% if (locals.user && locals.user.role_name === 'admin') {
            <div class="form-group">
                <button type="submit">Update Project</button>
            </div>
        <% } %>
    </form>

</main>
<%- include('partials/footer') %>