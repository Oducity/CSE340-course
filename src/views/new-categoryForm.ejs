<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <form action="/new-categoryForm" method="POST">
    <div class="form-group">
      <label for="category_name">Enter Category Name</label>
      <input
        type="text"
        name="category_name"
        id="category_name"
        minlength="3"
        maxlength="100"
        required
      />
    </div>
    <div class="form-group">
      <button type="submit">Submit Category</button>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
