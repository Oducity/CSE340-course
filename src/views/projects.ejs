<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Service Projects</h2>
  <ul class="list">
    <% projects.forEach((project) => { %>
      <li class="project-item">
        <h3><%= project.organization %></h3>
        <p><strong>Title:</strong><span> <%= project.projectTitle %></span></p>
        <p><strong>Description:</strong><span> <%= project.projectDescription %></span></p>
        <p><strong>Location:</strong><span> <%= project.projectLocation %></span></p>
        <p><strong>Date:</strong><span> <%= project.projectDate %></span></p>
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
