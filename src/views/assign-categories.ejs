<%- include('partials/header') %>
<main>
    <h1><%= projectDetails.projectTitle %></h1>
    <h2><%= title %></h2>
    <form action="/assign-categories/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <% allCategories.forEach(category => { %>
                <div class="edit-categories">
                    <input
                    type="checkbox"
                    id="category-<%= category.category_id %>"
                    name="categoryId"
                    value="<%= category.category_id %>"
                    <%= assignedCategories.some( asCat => asCat.categoryId === category.category_id) ? 'checked' : '' %>
                    />
                    <label for="category-<%= category.category_id %>"> <%= category.category_name %></label>
                </div>
            <% }) %>
        </div>
        <% if(locals.user && locals.user.role_name === 'admin') { %>
            <button type="submit"> Update Categories</button>
        <% } %>
    </form>

</main>
<%- include('partials/footer') %>
