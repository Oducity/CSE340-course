<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Here are a few of our partner organizations:</p>

  <ul class="list">
    <% organizations.forEach((organization) => { %>
      <li class="organization-item">
        <span class="logo-name-email">
          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.organization_name %> logo"
          />
          <span>
            <strong>
              <a href="/organization/<%= organization.organization_id %>">
                <%= organization.organization_name %>
              </a>
            </strong> :
          </span>
          <span><%= organization.organization_email %></span>
        </span>
        <span class="description"><%= organization.description %></span>
      </li>
    <% }); %>
    <p class="add-org">
      <a href="/new-organization">
        Add a new organization
      </a>
    </p>
  </ul>
</main>
<%- include('partials/footer') %>
